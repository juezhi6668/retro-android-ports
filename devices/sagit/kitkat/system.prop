#
# system.prop for sagit (Xiaomi Mi 6, KitKat) — verify each entry live
#
# Display density: 480 is stock Mi 6 (ro.sf.lcd_density=480) on a 1080x1920
# 5.15" panel. Read it back from the running ROM before locking
# (getprop ro.sf.lcd_density) — measure, don't guess (cooper 120-vs-160 lesson).
ro.sf.lcd_density=480

# Wifi interface (WCN3990; confirm on stock: wlan0)
wifi.interface=wlan0

# Model/brand (must match full_sagit.mk)
ro.product.model=MI 6
ro.product.brand=Xiaomi
ro.product.manufacturer=Xiaomi
ro.product.device=sagit

# TODO: ril_class / mobiledata.interfaces once the MSM8998 RIL path is
# evaluated (no cellular on first bringup — cf. cooper rild-removed).
# TODO: camera media profiles once a camera HAL exists (USE_CAMERA_STUB for now).

# GLES: the Adreno 540 driver reports ES 3.2 (eglQueryString); 0x30002 is what
# the framework announces to apps (196610).
ro.opengles.version=196610
