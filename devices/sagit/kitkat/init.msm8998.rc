# init.msm8998.rc — KitKat for the msm8998 boards: Xiaomi Mi 6 ("sagit") and
# Mi MIX 2 ("chiron"). One file for both — same SoC, same 4.4 kernel, same
# UFS/GPT partition layout, same WCN3990 + legacy ipc-router WLAN stack.
# Imported from init.rc via `import /init.${ro.hardware}.rc` with
# androidboot.hardware=msm8998, exactly once — do NOT add a second explicit
# import (it double-parses this file and spams ignored-duplicate errors for
# every service below).
#
# Mounts: every candidate path gets its OWN `on init` stanza. A failing init
# command aborts its action, so one bad mount must not take the rest down
# (maple TEST 6). The by-name level and the ufshc-direct level are both tried;
# whichever exists mounts, the other fails silently. fstab.msm8998 does the
# same at the fs stage, so a boot survives either path winning.

import /init.msm8998.usb.rc
import /init.msm8998.ril.rc

on init
    # PERMISSIVE SELinux for bringup: KitKat policy mismatches the 4.4 kernel
    # everywhere; enforcing buries the boot in denials. Re-enable + audit later.
    setenforce 0

# NOTE: no coldboot wait — KitKat init has no `wait_for_coldboot_done`
# (invalid command, aborts the action). fstab.msm8998's `wait` covers timing.
on init
    mkdir /cache 0770 system cache
    mkdir /persist 0771 system system

# system
on init
    mount ext4 /dev/block/platform/soc/by-name/system /system ro wait
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/system /system ro wait
# Measured 2026-10-24: system=sda18, userdata=sda17, cache=sda16, persist=sda14.
# The stock ROM exposes the ufshc-level by-name, so the second stanza is the
# one expected to resolve; the first is the maple-verified KitKat layout.

# qcom subsystem safety: every subsystem defaults to restart_level=SYSTEM, so
# a dsp crash panics the phone. Set RELATED before anything boots a subsystem
# (maple TEST 39). Wrong indices fail silently on kernels that expose fewer.
on init
    write /sys/bus/msm_subsys/devices/subsys0/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys1/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys2/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys4/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys5/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys6/restart_level RELATED

# data
on init
    mount ext4 /dev/block/platform/soc/by-name/userdata /data nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/userdata /data nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

# cache
on init
    mount ext4 /dev/block/platform/soc/by-name/cache /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/cache /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

# persist (sensors / wifi MAC / calibration live here)
on init
    mount ext4 /dev/block/platform/soc/by-name/persist /persist nosuid nodev wait barrier=1
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/persist /persist nosuid nodev wait barrier=1

on init
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/wifi 0770 wifi wifi
    # KitKat wifi.c expects these but never creates them (CHARQUIRKS wifi):
    # supplicant ctrl-socket dir and dhcp lease dir.
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/log 0775 system log
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 system system
    # PRODUCT_COPY_FILES lands 644; the diag scripts must exec.
    chmod 0755 /system/bin/dump-boot-log.sh
    chmod 0755 /sbin/autowinch.sh

on init
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw

    # firmware_class.path: the kernel resolves firmware from the requester's
    # root; /vendor -> /system/vendor, where the product makefiles install the
    # modem/adsp/a540 blobs (chiron adds the tas2559 amp containers). A miss
    # stalls ~60 s per file in ueventd.
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    # Modem first (PIL from /vendor/firmware), then the ADSP: with the service
    # locator enabled the ADSP's card/slimbus clients register through it and
    # the locator's domain data comes from the modem's servreg_loc service.
    start pdserve
    start modem_hold
    start adsp_boot
    # No /dev/alarm on the 4.4 kernel and the PMIC RTC is read-only: restore
    # wall time from the RTC + the offset system_server saved (rtc-restore,
    # patches/kitkat/frameworks-base-time-without-dev-alarm.patch).
    start rtc-restore
    # Zero-copy presentation: SurfaceFlinger's ION buffers are committed to the
    # MDSS pipe by fbpresentd (64-bit; the 32-bit compat path of
    # MSMFB_ATOMIC_COMMIT crashes this kernel). Must be up before the first
    # post; gralloc.msm8998 falls back to copy + FBIOPUT_VSCREENINFO otherwise
    # (persist.gralloc.fb_commit=0 forces the copy path).
    start fbpresentd
    # Touch: both boards use the Synaptics DSX driver (sagit_defconfig /
    # chiron_defconfig: CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_*). Unlike maple's
    # clearpad there is no post_probe_start gate to write — the driver probes
    # on its own. verify-me: `getevent -p` must list an ABS_MT device; the idc
    # filename must match that device's name (synaptics_dsx.idc is a guess —
    # rename per `dumpsys input` if needed).

on boot
    # Safety net: (re)start adbd now that init is up. No-op if running.
    start adbd
    # Bind the configfs gadget unconditionally: the sys.usb.config trigger is
    # unreliable (UsbDeviceManager owns the property once system_server runs).
    start usbudc
    start bootlog
    # bootloop guard: reboots to TWRP only if the boot never comes alive
    start autowinch

# LightsService writes these from system_server (uid system); the kernel
# registers every LED class attribute root:root 0644. Own stanza: a missing
# node aborts the rest of the action.
on boot
    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/white/trigger
    chown system system /sys/class/leds/white/brightness
    chown system system /sys/class/leds/white/blink
    chown system system /sys/class/leds/wled/brightness

# unattended-bringup guard: stands down when sys.boot_completed=1 or adbd is
# running; otherwise reboots to recovery after the fuse (default 900 s).
service autowinch /sbin/autowinch.sh
    user root
    oneshot
    disabled

# DIAG: no logcat sink (4.4 kernel has no CONFIG_LOGGER) — snapshots kmsg,
# loadavg and waiter channels to /data/misc for a TWRP-side pull.
service bootlog /system/bin/dump-boot-log.sh
    user root
    disabled

# internal storage only — no microSD on either board, so no fuse_sdcard1 service
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class main

service fbpresentd /system/bin/fbpresentd
    class core
    user root
    group root graphics
    disabled

service rtc-restore /system/bin/rtc-restore
    class core
    user root
    oneshot
    disabled

# Modem boot + hold: opening /dev/subsys_modem runs the PIL load (mba.mbn,
# modem.mdt + modem.b00-*) and the fd must stay open for the life of the
# system (closing it shuts the modem down). Stock holds it from rild/tad;
# KitKat has neither. WLAN needs this: WLFW ("wlan/fw") is a modem QMI
# service. Missing firmware makes the open fail EAGAIN — the script retries.
service modem_hold /system/bin/sh /sbin/modem-hold.sh
    class core
    user root
    group root
    disabled

# SERVREG_LOC (QMI 0x40) provider: 32-bit stand-in for the 64-bit pd-mapper
# the stock ROM runs; serves the domain tables the kernel's service locator
# (and the modem) use to boot the WLAN PD.
service pdserve /system/bin/pdserve
    class core
    user root
    group root

# ADSP boot, sequenced after the modem (bounded 20 s wait, resolved by NAME —
# the msm8998 subsystem indices differ from Sony's). Without this write the sound
# card never probes ("No soundcards found").
service adsp_boot /system/bin/sh /sbin/adsp-boot.sh
    class core
    user root
    group root
    oneshot
    disabled

# Wifi: qca_cld3 is built into the kernel, so no insmod — but KitKat's
# wifi.c starts the supplicant by service name, and without these definitions
# `ctl.start wpa_supplicant` is a silent no-op. hammerhead pattern.
service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf \
    -puse_p2p_group_interface=1 -e/data/misc/wifi/entropy.bin \
    -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

# ---- WLAN bring-up stack (WCN3990 behind the modem's wlan_pd) --------------
# sagit and chiron share the WCN3990 + msm8998 legacy ipc-router, so this block
# is common; the scripts live in devices/sagit/kitkat/ (the shared tree) and land
# in the boot ramdisk as /sbin from both product makefiles.
#
# Why these are not ordinary init services:
#  - rmt_storage and cnss-daemon are 64-bit vendor binaries. Exec'd directly by
#    KitKat init they exit silently in ~3 s; the identical command line from a
#    shell lives forever. wf-efs-keeper.sh owns them and respawns them across
#    SSRs — without that the modem self-crashes every 41 s and never gets a long
#    enough life to load wlanmdsp.mbn.
#  - the ipc-router IRSC completion gates every user-space QMI sendmsg on this
#    kernel and only fires when an IRSC_PORT is closed. Nothing here ever closed
#    one, so cnss-daemon's wlfw_bdf_download_req hung forever: no BDF, no
#    FW_READY, no wlan0. wf-setup.sh fires it at post-fs-data with the static
#    wlq (installed as /system/bin/wlq by the build, /sbin/wlq in a repacked
#    image), which is early enough that wlan0 exists before the framework
#    first touches WiFi. Full write-up: docs/devices/chiron/wifi-progress.md.
#  - the framework race is only *mostly* won: WifiService auto-enables at ~29 s
#    while icnss reaches FW_READY at ~41 s, and WifiMonitor.startMonitoring()
#    burns 6 connect tries and then drops wlan0 from its iface map for the rest
#    of the boot. So wf-setup.sh keeps wpa_supplicant.conf root:root 0600 during
#    that window (the attempt then fails inside wifi.c before init is touched,
#    which IS recoverable), and wf-wifi-gate.sh unlocks it as soon as wlan0
#    appears and drives the single genuine off->on toggle that SettingsStore
#    accepts — handleWifiToggled() ignores a request for the state it already
#    tracks, so a bare `svc wifi enable` with wifi_on already 1 does nothing.
#
# Everything is `disabled` and started from the action below, so no part of this
# depends on class_start ordering.
on post-fs-data
    # wifi.interface: the AOSP builds get this from kitkat/system.prop, but a
    # prebuilt ROM's build.prop does not carry it -- and hardware/libhardware_legacy
    # wifi.c falls back to its emulator test iface ("sta") when the property is
    # unset, so wifi_connect_to_supplicant() opens /dev/socket/wpa_sta, fails 5
    # retries, and WifiMonitor drops wlan0 from its iface map for the whole boot
    # ("startMonitor called with unknown iface=wlan0"). Set it here so the value
    # exists before system_server comes up, whichever image this ramdisk lands in.
    setprop wifi.interface wlan0
    start wf-setup
    start wf-efs
    start wf-wifi-gate
    start time-sync

service wf-setup /system/bin/sh /sbin/wf-setup.sh
    class main
    user root
    group root
    oneshot
    disabled

service wf-efs /system/bin/sh /sbin/wf-efs-keeper.sh
    class main
    user root
    group root
    disabled
    # (no "respawn" keyword: KitKat init rejects it and restarts any service that
    # is not "oneshot" on exit, which is what we want for these two.)

# vndbinder context manager: the vendor cnss-daemon's libbinder waits forever
# for a context manager on /dev/vndbinder. This kernel has vndbinder but KitKat
# ships none, so sm-vndk is KitKat's own static servicemanager with its
# "/dev/binder" string patched to "/dev/vb" (wifi-tools/patch-sm-vndk.py), and
# wf-setup.sh makes /dev/vb -> /dev/vndbinder.
service wf-sm /system/bin/sm-vndk
    class main
    user root
    group root
    disabled
    # (no "respawn" keyword: KitKat init rejects it and restarts any service that
    # is not "oneshot" on exit, which is what we want for these two.)

# One boot-time pass: unlock the supplicant config when the driver shows up,
# then drive the off->on toggle. oneshot on purpose — the script exits as soon
# as the framework reports enabled, and a respawn loop would keep spawning a
# Dalvik `settings`/`dumpsys` client for nothing.
service wf-wifi-gate /system/bin/sh /sbin/wf-wifi-gate.sh
    class main
    user root
    group root
    disabled
    oneshot

# ---- wall clock (rides on the WLAN stack above) ----------------------------------
# This kernel has no /dev/alarm and the PM8998 RTC has no allow-set-time, so the only
# writer of the wall clock is root. time-sync.sh waits for a DHCP lease, lets
# /system/bin/time-sync take the time from the network (SNTP, HTTP Date fallback -- UDP/123
# is filtered on this network) and settimeofday() it, and stores
# /data/system/time/rtc_offset, which the rtc-restore service above post-fs-data applies
# at the next boot. Needed because a prebuilt ROM (MIUI V5) ships stock 4.4 framework JNI,
# where SystemClock.setCurrentTimeMillis() only works through /dev/alarm and every attempt
# logs "Unable to open alarm driver"; on the built images the patched framework writes the
# same offset file, so both flavours restore time the same way.
service time-sync /system/bin/sh /sbin/time-sync.sh
    class main
    user root
    group root
    disabled
