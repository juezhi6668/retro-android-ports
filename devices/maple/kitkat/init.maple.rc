# init.maple.rc — KitKat skeleton for Sony maple (MSM8998, GPT/ext4)
# SKELETON: mounts + early USB only. Imported from init.rc via
# `import /init.${ro.hardware}.rc` (ro.hardware=maple), exactly once —
# do NOT add a second explicit import (it used to double-parse this file
# and spam ignored-duplicate errors for every service below).
# the KitKat init.rc itself is still TODO — start from aosp-kitkat
# system/core/rootdir/init.rc once synced, the way cooper's init.rc was
# derived from Donut's).
# Block paths: /dev/block/bootdevice/by-name/* (from TWRP
# fstab_maple.recovery). VERIFY on stock before first boot.

# Configfs USB gadget (adbd + usbudc services, sys.usb.config trigger).
# WITHOUT this import the usbudc service is unknown to init and there is
# no USB at all (regression seen 2026-10-15: this import lived only on
# the build server and a repo→server sync dropped it).
import /init.maple.usb.rc

on early-init
    # MSM8998 USB gadget (DWC3, a800000.dwc3) — KitKat-era functionfs/adb
    # path TBD against the 4.4 kernel; android_usb fallback kept so adb has
    # a chance on first bringup. Nonexistent-path writes fail silently.
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 0FCE
    write /sys/class/android_usb/android0/idProduct 41DB
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer Sony
    write /sys/class/android_usb/android0/iProduct G8141
    write /sys/class/android_usb/android0/enable 1

on init
    # PERMISSIVE SELinux for bringup: KitKat's policy mismatches the 4.4
    # kernel everywhere; enforcing mode buries the boot in denials (and a
    # suspect audit-backlog D-state storm pinned load at 6+ with zero CPU
    # for 11+ min). Policy audit is a later project; cooper precedent says
    # get the boot green first. TODO: re-enable + audit.
    setenforce 0
    # NOTE: no coldboot wait here: KitKat init has no
    # `wait_for_coldboot_done` (invalid command, aborts the action) and the
    # mounts below use RAW sda/sde nodes (stable GPT numbers, present
    # without ueventd symlinks), so no wait is needed.

# NOTE: each mount is its OWN `on init` action. A failing init command
# aborts its action SILENTLY — one bad mount used to kill persist + all
# mkdirs below it. Independent stanzas isolate failures (proven: cache
# mount failure hid everything after it in TEST 6).
# GPT/ext4 mounts by RAW node (sde/sda numbers from TWRP by-name dump
# 2026-10-13: stable GPT partition numbers, no symlink timing involved):
# system->sde46, cache->sda5, userdata->sda15, persist->sda4.
# KitKat mount syntax: space-separated FLAGS, ONE trailing options arg.
# /cache + /persist have NO ramdisk dirs from stock init.rc — create them
# HERE, before the mounts: mount onto a missing dir fails ENOENT SILENTLY
# (seen 2026-10-14: only /system + /data mounted, no /cache or /persist).
on init
    mkdir /cache 0770 system cache
    mkdir /persist 0771 system system

on init
    mount ext4 /dev/block/sde46 /system ro wait

# qcom subsystem safety (CHARQUIRKS kernel: "every qcom subsystem defaults
# to SYSTEM restart, so any dsp crash panics the phone. subsys.sh sets
# adsp, slpi, wlan and cdsp to RELATED before anything boots them").
# Live 2026-10-16 all 7 subsys (ipa_fws venus spss a540_zap adsp slpi
# modem) read SYSTEM; stock init.maple.rc writes RELATED for all 7. This
# runs BEFORE anything boots a subsystem (adsp-boot.sh, modem-hold): with
# SYSTEM, closing /dev/subsys_modem rebooted the whole phone (seen live
# 2026-10-17: "icnss: Modem went down, state: 0x80" → SYSTEM restart →
# reboot). Writes that miss (older kernels) fail silently.
on init
    write /sys/bus/msm_subsys/devices/subsys0/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys1/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys2/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys4/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys5/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys6/restart_level RELATED

on init
    mount ext4 /dev/block/sda15 /data nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

on init
    mount ext4 /dev/block/sda5 /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

on init
    mount ext4 /dev/block/sda4 /persist nosuid nodev wait barrier=1

on init

    mkdir /data/misc 01771 system misc
    mkdir /data/misc/wifi 0770 wifi wifi
    # KitKat wifi.c (hardware/libhardware_legacy/wifi/wifi.c) expects these
    # but never creates them: the supplicant's ctrl socket dir (service
    # wpa_supplicant runs with -O/data/misc/wifi/sockets) and dhcp's dir.
    # Without them the supplicant cannot bind its ctrl socket and dhcpcd
    # has nowhere to write leases (CHARQUIRKS wifi: "/data/misc/wifi,
    # /data/misc/wifi/sockets, /data/misc/dhcp have to be made in
    # post-fs-data, 4.2's init.rc doesn't" — same on KitKat; verified
    # missing live 2026-10-16: only softap.conf existed under
    # /data/misc/wifi). hammerhead's init.grouper.rc makes the same set.
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/log 0775 system log
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 system system
    # PRODUCT_COPY_FILES lands 644; the diag scripts must exec.
    chmod 0755 /system/bin/dump-boot-log.sh
    chmod 0755 /sbin/autowinch.sh

    # modem/firmware partitions are NOT mounted on this port: the modem +
    # WLAN firmware (mba.mbn, modem.mdt/modem.b00-28, wlanmdsp.mbn) ships in
    # /system/vendor/firmware via the FW_DIR block in full_maple.mk like the
    # adsp blobs, so the PIL loader never depends on the vfat modem
    # partition being mounted — the live symlink+mount experiment died
    # exactly that way (open /dev/subsys_modem → EAGAIN "Try again" when
    # the mount was missing, TEST 38). bt_firmware stays unmounted until
    # bluez bringup.
    # TODO: 32-bit-userspace cgroup/lowmemorykiller tuning for 4 GB RAM
    # (cooper's 6-slot adj/minfree values do NOT carry over; re-derive from
    # KitKat ActivityManager defaults + measured pressure).

on init
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    mkdir /mnt/media_rw/sdcard1 0700 media_rw media_rw
    mkdir /storage/sdcard1 0700 root root
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    export SECONDARY_STORAGE /storage/sdcard1
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw

    # the kernel resolves this from the requester's root, glrenderd's chroot has the a540 firmware there
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    # Boot and hold the modem (modem-hold.sh): opening /dev/subsys_modem
    # runs the PIL load from /vendor/firmware (mba.mbn + modem.mdt +
    # modem.b00-28). Must come before adsp_boot: with the service locator
    # enabled the ADSP clients (tavil card, slimbus) register through it,
    # and the locator's domain data comes from the modem's servreg_loc
    # service (TEST 39).
    start pdserve
    start modem_hold
    # Boot the adsp (TEST 36: `echo 1 > /sys/kernel/boot_adsp/boot` with
    # adsp.* staged is what unblocked the whole audio stack live —
    # tavil/tasha slim probes, WSA amps, Q6 DAIs, APR, and the tasha card
    # all registered within a second). adsp.* + cpe_9335.* ship in the
    # image via the FW_DIR block in full_maple.mk (out-of-git blobs).
    # Without this write the card never probes ("No soundcards found").
    # adsp-boot.sh waits (bounded, 20 s) for the modem when the locator is
    # on, then writes boot_adsp regardless.
    start adsp_boot
    # glrenderd owns the panel (single flipper): surfaceflinger in glrenderd mode posts
    # via rcFBPost and never FBIOPANs itself, so only this daemon pans fb0. it must be up
    # before surfaceflinger's first egl/gralloc probe (both latch hw-vs-software once per
    # process, with a 30s wait), hence here in post-fs-data, not on boot. glrenderd doubles
    # fb0's yres_virtual itself if the fb HAL hasn't yet, so the old flips=0 startup race
    # and the EBUSY wedge from two racing flippers are both gone (charquirks single-flipper
    # design; maple TEST 30). disable only for software-fallback experiments
    # (`stop glrenderd` live needs a surfaceflinger restart to take effect; hwchroot
    # now bounces SF itself on any 2nd+ daemon start of a boot — maple TEST 41).
    start glrenderd

    # the clearpad driver doesn't finish probing (no touch events) until this, lineage does the same
    write /sys/devices/virtual/input/clearpad/post_probe_start 1

on boot
    # Safety net: (re)start adbd now that init is up. No-op if running.
    start adbd
    # Bind the configfs USB gadget unconditionally: the
    # `on property:sys.usb.config=adb` trigger proved unreliable (it never
    # fired on the first full-boot 2026-10-15 — UsbDeviceManager owns that
    # property once system_server runs — so usbudc never started and there
    # was no USB at all). usbudc.sh re-binds whenever unbound; harmless if
    # the trigger already started it (second start is a no-op).
    start usbudc
    start bootlog

# NOTE: autowinch (auto-return to TWRP after 15 min) was removed
# 2026-10-15 once USB adb worked — it kept killing every good boot.
# If a future boot wedges with no adb, re-add:
#   on boot: start autowinch
#   service autowinch /sbin/autowinch.sh (user root, disabled, oneshot)

# DIAG (test 7): no USB/adb yet (DWC3 needs functionfs bringup — later),
# so capture logs to files for TWRP-side pull. Remove once adb works.
# NOT oneshot: the script loops forever snapshotting ps/loadavg/dalvik.
service bootlog /system/bin/dump-boot-log.sh
    user root
    disabled

# class main not late_start, late_start only fires from mount_all and the mounts here are by hand
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class main

# vold starts this by name (fuse_<label>) once it has mounted the card on /mnt/media_rw/sdcard1
service fuse_sdcard1 /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/sdcard1 /storage/sdcard1
    class main
    disabled

# adreno renderer for the whole ui, surfaceflinger and apps talk to it over the glrenderd socket.
# stats and crashes land in dmesg
service glrenderd /system/bin/sh /sbin/glrenderd.sh
    class core
    disabled

# Modem boot + hold (TEST 39, 2026-10-17). Opening /dev/subsys_modem runs
# subsystem_get_with_fwname("modem") → the PIL boot: MBA first (mba.mbn,
# pil-msa.c:560), then modem.mdt + modem.b00-28 (peripheral-loader), all
# from firmware_class.path=/vendor/firmware. The fd must stay open for the
# life of the system: closing it shuts the modem down. Stock holds it from
# rild/tad; KitKat here has neither, so the script opens it and sleeps.
# WLAN depends on this: WLFW ("wlan/fw") is a modem QMI service, and the
# WLAN PD only starts once the modem is up with icnss' servreg listener
# registered. Missing firmware makes the open fail EAGAIN ("Try again",
# not ENOENT — TEST 38); the script retries, so an init/mount race can't
# wedge it silently.
service modem_hold /system/bin/sh /sbin/modem-hold.sh
    class core
    user root
    group root
    disabled

# SERVREG_LOC (QMI 0x40) provider: 32-bit stand-in for the 64-bit
# pd-mapper the stock ROM runs (this port has no 64-bit userspace).
# Serves the domain lists from the modem partition .jsn tables so the
# kernel's service-locator (and the modem's TMS) can boot the WLAN PD.
# Stays running for the life of the system.
service pdserve /system/bin/pdserve
    class core
    user root
    group root

# ADSP boot, sequenced after modem_hold: with service_locator.enable=1 the
# audio side (tavil/tasha card via audio_notifier, slimbus) registers
# through the locator, whose domain data is served by the modem's
# servreg_loc, so boot the ADSP after the modem reads ONLINE — bounded to
# 20 s so audio still comes up if the modem never does. Replaces the bare
# `write /sys/kernel/boot_adsp/boot 1` (TEST 36).
service adsp_boot /system/bin/sh /sbin/adsp-boot.sh
    class core
    user root
    group root
    disabled

# Wifi (Qualcomm WCN3990/cherokee, qca_cld3 built into the 4.4 kernel:
# /sys/module/wlan exists, /dev/wlan chr 229,0, driver v5.1.1.77V live
# 2026-10-16). KitKat wifi.c treats the driver as always loaded (no
# WIFI_DRIVER_MODULE_*), so no insmod service is needed — but the
# supplicant + dhcpcd SERVICES were never defined, so `ctl.start
# wpa_supplicant` from wifi.c was a silent no-op and wifi could never
# start. hammerhead pattern (overlay -I flags included; the overlay stubs
# ship via full_maple.mk).
# CHARQUIRKS divergence: pdx203 runs plain wpa_supplicant (no
# android.hardware.wifi.direct.xml); maple defines both services like
# hammerhead and lets the framework choose.
service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf \
    -puse_p2p_group_interface=1 -e/data/misc/wifi/entropy.bin \
    -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

# (qcom subsystem restart_level safety block moved to `on init`, right
# after the /system mount — it must run before anything boots a subsystem.
# See TEST 39.)
