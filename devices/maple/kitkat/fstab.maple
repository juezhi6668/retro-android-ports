# fstab.maple — KitKat skeleton (GPT/ext4)
# Block paths from TWRP yoshino-common recovery/fstab_maple.recovery
# (/dev/block/bootdevice/by-name/*) — NOT the mmcblk guess in rev 1.
# TODO: confirm on stock via /proc/partitions + `ls -l /dev/block/bootdevice/by-name`
# before flashing anything. dsp/bt_firmware/modem rows are reference-only
# until the corresponding KitKat services exist.
/dev/block/bootdevice/by-name/system   /system  ext4  ro                                                              wait
/dev/block/bootdevice/by-name/userdata /data    ext4  nosuid,nodev,noatime,nodiratime,nobarrier,noauto_da_alloc        wait,check,encryptable=footer
/dev/block/bootdevice/by-name/cache    /cache   ext4  nosuid,nodev,noatime,nodiratime,nobarrier                        wait,check
/dev/block/bootdevice/by-name/persist  /persist ext4  nosuid,nodev,barrier=1                                          wait,notrim
