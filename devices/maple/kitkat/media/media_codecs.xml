<?xml version="1.0" encoding="utf-8" ?>
<!--
     /system/etc/media_codecs.xml for maple (KitKat 4.4.4).

     KitKat's OMXCodec::Create asks MediaCodecList (which parses
     /etc/media_codecs.xml) which components exist; AOSP ships this file only
     for goldfish/sdk, so a product that does not provide one has NO codecs at
     all. The failure is silent at default log level ("No matching codecs!" is
     ALOGV, compiled out with -DNDEBUG): OMXCodec::Create returns NULL and
     AwesomePlayer fails prepare with UNKNOWN_ERROR (0x80000000, logged as
     "error (1, -2147483648)"), which is what Music/SoundPool reported before
     this file existed. audio/raw is unaffected because AwesomePlayer bypasses
     OMX for it — that is why WAV played while ogg/mp3 did not.

     The list below is exactly the SoftOMXPlugin table in
     frameworks/av/media/libstagefright/omx/SoftOMXPlugin.cpp restricted to the
     libraries this image builds (17 libstagefright_soft_*.so; no qcom OMX
     components — the stock vendor tree is a 64-bit Android 15 closure and has
     no KitKat-era OMX core). OMX.google.raw.decoder is not listed on purpose:
     MediaCodecList adds it itself, and listing it twice gives two entries.
-->
<MediaCodecs>
    <Decoders>
        <MediaCodec name="OMX.google.mp3.decoder" type="audio/mpeg" />
        <MediaCodec name="OMX.google.amrnb.decoder" type="audio/3gpp" />
        <MediaCodec name="OMX.google.amrwb.decoder" type="audio/amr-wb" />
        <MediaCodec name="OMX.google.aac.decoder" type="audio/mp4a-latm" />
        <MediaCodec name="OMX.google.g711.alaw.decoder" type="audio/g711-alaw" />
        <MediaCodec name="OMX.google.g711.mlaw.decoder" type="audio/g711-mlaw" />
        <MediaCodec name="OMX.google.vorbis.decoder" type="audio/vorbis" />
        <MediaCodec name="OMX.google.gsm.decoder" type="audio/gsm" />

        <MediaCodec name="OMX.google.mpeg4.decoder" type="video/mp4v-es" />
        <MediaCodec name="OMX.google.h263.decoder" type="video/3gpp" />
        <MediaCodec name="OMX.google.h264.decoder" type="video/avc" />
        <MediaCodec name="OMX.google.vp8.decoder" type="video/x-vnd.on2.vp8" />
        <MediaCodec name="OMX.google.vp9.decoder" type="video/x-vnd.on2.vp9" />
    </Decoders>

    <Encoders>
        <MediaCodec name="OMX.google.aac.encoder" type="audio/mp4a-latm" />
        <MediaCodec name="OMX.google.amrnb.encoder" type="audio/3gpp" />
        <MediaCodec name="OMX.google.amrwb.encoder" type="audio/amr-wb" />
        <MediaCodec name="OMX.google.h263.encoder" type="video/3gpp" />
        <MediaCodec name="OMX.google.h264.encoder" type="video/avc" />
        <MediaCodec name="OMX.google.mpeg4.encoder" type="video/mp4v-es" />
        <MediaCodec name="OMX.google.flac.encoder" type="audio/flac" />
        <MediaCodec name="OMX.google.vp8.encoder" type="video/x-vnd.on2.vp8" />
    </Encoders>
</MediaCodecs>
