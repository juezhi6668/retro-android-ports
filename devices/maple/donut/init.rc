# Maple (Sony Xperia XZ Premium G8141/G8142) init.rc for Android Donut.
# Derived from AOSP Donut system/core/rootdir/init.rc:
# MTD/yaffs2 mounts replaced with GPT/ext4 raw block nodes (cooper's
# precedent: raw nodes are stable, and Donut's ueventd cannot recreate the
# kernel's /dev/block/platform/.../by-name symlinks), hardware services moved
# to /init.maple.rc (auto-parsed by Donut init: get_hardware_name() lowercases
# and truncates the kernel cmdline's androidboot.hardware=maple).
# Installed to ramdisk root because TARGET_PROVIDES_INIT_RC=true.
#
# Block map (GPT, from the KitKat port's TWRP dump — stable numbers):
#   sde46=/system  sda15=/data  sda5=/cache  sda4=/persist  sde35=boot

on init

sysclktz 0

loglevel 3

# setup the global environment
    export PATH /sbin:/system/sbin:/system/bin:/system/xbin
    export LD_LIBRARY_PATH /system/lib
    export ANDROID_BOOTLOGO 1
    export ANDROID_ROOT /system
    export ANDROID_ASSETS /system/app
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard
    export BOOTCLASSPATH /system/framework/core.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/android.policy.jar:/system/framework/services.jar
    write /cache/m01-env ok

# /dev/log FIFO shim: create FIFOs early (before any service opens them).
on init
    exec /sbin/logshim --init

# Backward compatibility
    symlink /system/etc /etc
    write /cache/m02-symlink ok

# create mountpoints and mount tmpfs on sqlite_stmt_journals
    mkdir /sdcard 0000 system system
    mkdir /system
    mkdir /data 0771 system system
    mkdir /cache 0770 system cache
    mkdir /sqlite_stmt_journals 01777 root root
    mount tmpfs tmpfs /sqlite_stmt_journals size=4m
    write /cache/m03-mkdirs ok

# NOTE: the stock Donut line `mount rootfs rootfs / ro remount` is REMOVED.
# It remounts the rootfs read-only, and on maple that kills the USB gadget
# bringup: init.maple.rc's `mkdir /config` + configfs mount run in later
# `on init` blocks and fail EROFS, so no ffs.adb instance is ever created
# and adbd can never open /dev/usb-ffs/adb/ep0 (verified on-device
# 2026-10-17 with a step-replicator init: `mkdir /config -> EROFS`, then
# `mount functionfs -> ENODEV`). Nothing on this port needs a read-only
# rootfs (it is RAM-backed anyway).

# Kernel sysctls (Donut-era tuning; paths that do not exist on the 4.4
# kernel log a failed write and the action continues).
    write /proc/sys/kernel/panic_on_oops 1
    write /proc/sys/kernel/hung_task_timeout_secs 0
    write /proc/sys/kernel/sched_latency_ns 10000000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 2000000
    write /cache/m04-sysctls ok

# Create cgroup mount points for process groups
    mkdir /dev/cpuctl
    mount cgroup none /dev/cpuctl cpu
    write /cache/m05-cgroup-mount ok
    chown system system /dev/cpuctl
    chown system system /dev/cpuctl/tasks
    chmod 0777 /dev/cpuctl/tasks
    write /dev/cpuctl/cpu.shares 1024
    write /cache/m06-cgroup-shares ok

    mkdir /dev/cpuctl/fg_boost
    chown system system /dev/cpuctl/fg_boost/tasks
    chmod 0777 /dev/cpuctl/fg_boost/tasks
    write /dev/cpuctl/fg_boost/cpu.shares 1024

    mkdir /dev/cpuctl/bg_non_interactive
    chown system system /dev/cpuctl/bg_non_interactive/tasks
    chmod 0777 /dev/cpuctl/bg_non_interactive/tasks
    # 5.0 %
    write /dev/cpuctl/bg_non_interactive/cpu.shares 52
    write /cache/m07-cgroup-done ok

# maple storage: GPT/ext4 by RAW node (stable GPT numbers; the kernel's
# by-name symlinks are not recreated by Donut's ueventd). Each mount in its
# own action block so failures are isolated (a failed command is logged and
# the rest of that block still runs, but one bad mount per block keeps the
# log readable — cooper TEST lesson).
# Bringup diagnostics: /cache is mounted FIRST so klogd (kernel-log mirror)
# and the step markers land on a partition TWRP can read after a failed
# boot. commit=1 makes the writes durable within ~1s (a hard reset otherwise
# loses up to 5s of ext4 journal; the mount option `sync` is INVALID as an
# ext4 data option — the kernel rejects the whole mount with
# "EXT4-fs (sda5): Unrecognized mount option "sync"", verified on-device
# 2026-10-17).
on init
    mount ext4 /dev/block/sda5 /cache nosuid nodev commit=1,noauto_da_alloc
    write /cache/dnut-01-cache ok
    write /dev/kmsg dnut-01-cache-mounted

on init
    mount ext4 /dev/block/sde46 /system ro
    write /cache/m08-system-mounted ok
    write /cache/dnut-02-system ok
    write /dev/kmsg dnut-02-system-mounted

on init
    mount ext4 /dev/block/sda15 /data nosuid nodev noauto_da_alloc,barrier=0
    write /cache/m09-data-mounted ok
    write /cache/dnut-03-data ok
    write /dev/kmsg dnut-03-data-mounted

on init
    mkdir /persist 0771 system system
    mount ext4 /dev/block/sda4 /persist nosuid nodev barrier=1
    write /cache/m10-persist-mounted ok

on init
    # We chown/chmod /data again because mount is run as root + defaults
    chown system system /data
    chmod 0771 /data

    # Same reason as /data above
    chown system cache /cache
    chmod 0770 /cache

    # This may have been created by the recovery system with odd permissions
    chown system system /cache/recovery
    chmod 0770 /cache/recovery

# create basic filesystem structure
on init
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0770 keystore keystore
    mkdir /data/misc/vpn 0770 system system
    mkdir /data/misc/vpn/profiles 0770 system system
    mkdir /data/local 0771 shell shell
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/data 0771 system system
    mkdir /data/app-private 0771 system system
    mkdir /data/app 0771 system system
    mkdir /data/property 0700 root root

    # create dalvik-cache and double-check the perms
    mkdir /data/dalvik-cache 0771 system system
    chown system system /data/dalvik-cache
    chmod 0771 /data/dalvik-cache

    # create the lost+found directories, so as to enforce our permissions
    mkdir /data/lost+found 0770
    mkdir /cache/lost+found 0770

    # double check the perms, in case lost+found already exists, and set owner
    chown root root /data/lost+found
    chmod 0770 /data/lost+found
    chown root root /cache/lost+found
    chmod 0770 /cache/lost+found
    write /cache/m11-datadirs ok

on boot
# basic network init
    ifup lo
    hostname localhost
    domainname localdomain

# set RLIMIT_NICE to allow priorities from 19 to -20
    setrlimit 13 40 40

# Define the oom_adj values for the classes of processes that can be
# killed by the kernel.  These are used in ActivityManagerService.
    setprop ro.FOREGROUND_APP_ADJ 0
    setprop ro.VISIBLE_APP_ADJ 1
    setprop ro.SECONDARY_SERVER_ADJ 2
    setprop ro.BACKUP_APP_ADJ 2
    setprop ro.HOME_APP_ADJ 4
    setprop ro.HIDDEN_APP_MIN_ADJ 7
    setprop ro.CONTENT_PROVIDER_ADJ 14
    setprop ro.EMPTY_APP_ADJ 15

# Define the memory thresholds at which the above process classes will
# be killed.  These numbers are in pages (4k).
    setprop ro.FOREGROUND_APP_MEM 1536
    setprop ro.VISIBLE_APP_MEM 2048
    setprop ro.SECONDARY_SERVER_MEM 4096
    setprop ro.BACKUP_APP_MEM 4096
    setprop ro.HOME_APP_MEM 4096
    setprop ro.HIDDEN_APP_MEM 5120
    setprop ro.CONTENT_PROVIDER_MEM 5632
    setprop ro.EMPTY_APP_MEM 6144

# Write value must be consistent with the above properties.
# Note that the driver only supports 6 slots, so we have HOME_APP at the
# same memory level as services.
    write /sys/module/lowmemorykiller/parameters/adj 0,1,2,7,14,15

    write /proc/sys/vm/overcommit_memory 1
    write /proc/sys/vm/min_free_order_shift 4
    write /sys/module/lowmemorykiller/parameters/minfree 1536,2048,4096,5120,5632,6144

    # Set init its forked children's oom_adj.
    write /proc/1/oom_adj -16

    # Permissions for System Server and daemons.
    chown radio system /sys/power/state
    chown radio system /sys/power/wake_lock
    chown radio system /sys/power/wake_unlock
    chmod 0660 /sys/power/state
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    chown system system /sys/class/timed_output/vibrator/enable
    chown system system /sys/class/leds/lcd-backlight/brightness
    # maple has TWO backlight nodes (lcd-backlight + wled, independent); the
    # KitKat lights HAL drives both. Donut's PowerManagerService writes
    # lcd-backlight directly; open up both.
    chown system system /sys/class/leds/wled/brightness
    chmod 0660 /sys/class/leds/wled/brightness
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0660 /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/blue/brightness
    chown root radio /proc/cmdline

# Define TCP buffer sizes for various networks
#   ReadMin, ReadInitial, ReadMax, WriteMin, WriteInitial, WriteMax,
    setprop net.tcp.buffersize.default 4096,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.wifi    4095,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.umts    4094,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.edge    4093,26280,35040,4096,16384,35040
    setprop net.tcp.buffersize.gprs    4092,8760,11680,4096,8760,11680

# Bring the USB gadget up (configfs skeleton is built in init.maple.rc) and
# start adbd: FunctionFS transport on this configfs-only kernel, adbd
# retries until usbudc has bound the UDC.
    start usbudc
    start adbd

    # vtouch must run BEFORE class_start default (i.e. before zygote/
    # system_server's EventHub opens the input devices), otherwise it
    # replaces event7 too late and touch is dropped. Service is `disabled`
    # in init.maple.rc so it is only started here.
    start vtouch

    class_start default

# Bringup marker: services were started (klogd + the /data snapshot will
# show what came up).
    write /cache/dnut-06-class-start ok
    write /dev/kmsg dnut-06-class-start-done

## Daemon processes to be run by init.
##
service console /system/bin/sh
    console

# Bringup diagnostics: mirror /dev/kmsg (init's own klog output + the kernel
# log) to /cache/kmsg.txt. First service in class default, runs from the
# ramdisk (no /system needed). Remove once the port is stable.
service klogd /sbin/klogd

# adbd is controlled by the persist.service.adb.enable system property, but
# on this port it is started unconditionally in `on boot` (eng build; the
# only way in while the port stabilizes).
service adbd /sbin/adbd
    disabled

on property:persist.service.adb.enable=1
    start adbd

on property:persist.service.adb.enable=0
    stop adbd

service servicemanager /system/bin/servicemanager
    user system
    critical
    onrestart restart zygote
    onrestart restart media

# vold DISABLED on this port: Donut's vold has no emulated-storage path
# (maple's internal storage is a fuse daemon KitKat-only) and no SD card is
# present; on foreign uevents Donut's vold crash-loops (NULL devpath,
# cooper lesson). Storage support returns with a NULL-guarded vold.
# service vold /system/bin/vold
#     socket vold stream 0660 root mount

service nexus /system/bin/nexus
    socket nexus stream 0660 root system
    disabled

# ril-daemon DISABLED on this port: there is no Donut RIL library for
# MSM8998; rild without its .so crash-loops and drags dependent services
# with it (cooper precedent).
# service ril-daemon /system/bin/rild
#     socket rild stream 660 root radio
#     socket rild-debug stream 660 radio system
#     user root
#     group radio cache inet misc

service debuggerd /system/bin/debuggerd

# /dev/log FIFO shim: capture framework logs to /cache/logcat.txt. Defined
# before zygote so the reader is up before liblog opens /dev/log/main.
service logshim /sbin/logshim

service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-system-server
    socket zygote stream 666

service media /system/bin/mediaserver
    user media
    group system audio camera graphics inet net_bt net_bt_admin

service bootsound /system/bin/playmp3
    user media
    group audio
    oneshot

service bootanim /system/bin/bootanimation
    user graphics
    group graphics
    disabled
    oneshot

service installd /system/bin/installd
    socket installd stream 600 system system

service keystore /system/bin/keystore
    user keystore
    group keystore
    socket keystore stream 666

# Bluetooth stack (BlueZ 3.x dbus/hcid/sdptool) DISABLED: maple's BT is a
# qca/cherokee combo driven over UART/QMI — no Donut transport exists.
# service dbus /system/bin/dbus-daemon --system --nofork
#     socket dbus stream 660 bluetooth bluetooth
#     user bluetooth
#     group bluetooth net_bt_admin
# service hcid /system/bin/hcid -s -n -f /etc/bluez/hcid.conf
#     socket bluetooth stream 660 bluetooth bluetooth
#     socket dbus_bluetooth stream 660 bluetooth bluetooth
#     group bluetooth net_bt_admin misc
#     disabled

# Boot diagnostics: /dev/log does not exist on this kernel (no Android
# logger driver), so init's kmsg output and dmesg are the only boot
# evidence. bootlog.sh snapshots both to /data (pullable via TWRP when adb
# is not up yet). Remove once the port is stable.
service bootlog /system/bin/sh /sbin/bootlog.sh
    oneshot

# Bringup safety net: if adb never comes up, return to TWRP after 15
# minutes so the captures on /cache can be read. With adb working, `adb
# reboot recovery` is the way back; kill this service (`adb shell ps`, then
# kill) if the session must outlive the countdown.
service autowinch /system/bin/sh /sbin/autowinch.sh
    oneshot
