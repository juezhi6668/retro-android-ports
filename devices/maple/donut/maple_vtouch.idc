# maple_vtouch: virtual single-touch device created by /sbin/maple_vtouch
# from the clearpad multi-touch node. Donut's EventHub needs this to
# classify the node as a touchscreen (not a touchpad/keyboard) and to
# apply the correct orientation handling on the 1080x1920 panel.
touch.deviceType = touchScreen
touch.orientationAware = 1
touch.size.calibration = none
touch.pressure.calibration = none
