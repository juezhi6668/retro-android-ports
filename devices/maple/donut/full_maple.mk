# Product definition: full_maple (Sony Xperia XZ Premium G8141, Donut 1.6)
# Donut-era product file. Mimics build/target/product/generic.mk + maple
# hardware, same structure as devices/cooper/donut/cooper.mk.

PRODUCT_PACKAGES := \
    AlarmClock \
    AlarmProvider \
    Calendar \
    Camera \
    DrmProvider \
    LatinIME \
    Mms \
    Music \
    Settings \
    Sync \
    Updater \
    CalendarProvider \
    SubscribedFeedsProvider \
    SyncProvider \
    vtouch

$(call inherit-product, $(SRC_TARGET_DIR)/product/core.mk)
$(call inherit-product, $(SRC_TARGET_DIR)/product/generic.mk)
# Donut ringtones/alarms/notifications (no Donut product includes sounds by
# default; AudioPackage2 is the "larger package for devices with larger
# internal flash" — maple has plenty).
$(call inherit-product, frameworks/base/data/sounds/AudioPackage2.mk)

PRODUCT_NAME := full_maple
PRODUCT_DEVICE := maple
PRODUCT_MODEL := G8141
PRODUCT_BRAND := sony
PRODUCT_MANUFACTURER := Sony

# maple-specific files (copied into system/ and root/ by the build system).
# NOTE: build.prop is generated by build/core/Makefile, which appends
# vendor/sony/maple/system.prop automatically (TARGET_DEVICE_DIR rule) —
# do NOT also PRODUCT_COPY_FILES it over the generated file.
PRODUCT_COPY_FILES += \
    vendor/sony/maple/init.rc:root/init.rc \
    vendor/sony/maple/init.maple.rc:root/init.maple.rc \
    vendor/sony/maple/usbudc.sh:root/sbin/usbudc.sh \
    vendor/sony/maple/bootlog.sh:root/sbin/bootlog.sh \
    vendor/sony/maple/autowinch.sh:root/sbin/autowinch.sh \
    vendor/sony/maple/qwerty.kl:system/usr/keylayout/qwerty.kl \
    vendor/sony/maple/gpio-keys.kl:system/usr/keylayout/gpio-keys.kl \
    vendor/sony/maple/maple_vtouch.idc:system/usr/idc/maple_vtouch.idc

# Kernel is a prebuilt blob (TARGET_PREBUILT_KERNEL, AndroidBoard.mk):
# vendor/sony/maple/kernel = Sony whatawurst 4.4.302 Image.gz-dtb dumped from
# the boot partition; out-of-git (same policy as KitKat). Not referenced here
# because AndroidBoard.mk installs it.
