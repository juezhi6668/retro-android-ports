# qwerty.kl — fallback key layout for maple (Donut 1.6).
# Loaded by EventHub for any input device without its own <name>.kl —
# on maple that is the qpnp_pon power-key device (name "qpnp_pon").
# Only Donut-legal keycode names and flags (WAKE / WAKE_DROPPED) may be
# used: KeyLayoutMap.cpp discards the WHOLE file on an unknown token.
# Scancodes: 114/115 volume, 116 power, 158 back, 102 home, 139 menu,
# 127/217 search, 212 camera (linux input.h KEY_*).
key 158   BACK              WAKE_DROPPED
key 102   HOME              WAKE
key 139   MENU              WAKE_DROPPED
key 127   SEARCH            WAKE_DROPPED
key 217   SEARCH            WAKE_DROPPED
key 115   VOLUME_UP         WAKE
key 114   VOLUME_DOWN       WAKE
key 116   POWER             WAKE
key 212   CAMERA
