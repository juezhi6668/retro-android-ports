# init.chiron.rc — KitKat for Xiaomi Mi MIX 2 (MSM8998, UFS/GPT/ext4)
# Imported from init.rc via `import /init.${ro.hardware}.rc` (ro.hardware=chiron,
# from androidboot.hardware=chiron), exactly once — do NOT add a second import.
#
# Mounts: every candidate path gets its OWN `on init` stanza. A failing init
# command aborts its action, so one bad mount must not take the rest down
# (maple TEST 6). The by-name level and the ufshc-direct level are both tried;
# whichever exists mounts, the other fails silently. fstab.chiron does the same
# at the fs stage, so a boot survives either path winning.

import /init.chiron.usb.rc

on init
    # PERMISSIVE SELinux for bringup: KitKat policy mismatches the 4.4 kernel
    # everywhere; enforcing buries the boot in denials. Re-enable + audit later.
    setenforce 0

# NOTE: no coldboot wait — KitKat init has no `wait_for_coldboot_done`
# (invalid command, aborts the action). fstab.chiron's `wait` covers timing.
on init
    mkdir /cache 0770 system cache
    mkdir /persist 0771 system system

# system
on init
    mount ext4 /dev/block/platform/soc/by-name/system /system ro wait
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/system /system ro wait

# qcom subsystem safety: every subsystem defaults to restart_level=SYSTEM, so
# a dsp crash panics the phone. Set RELATED before anything boots a subsystem
# (maple TEST 39). Wrong indices fail silently on kernels that expose fewer.
on init
    write /sys/bus/msm_subsys/devices/subsys0/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys1/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys2/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys4/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys5/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys6/restart_level RELATED

# data
on init
    mount ext4 /dev/block/platform/soc/by-name/userdata /data nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/userdata /data nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

# cache
on init
    mount ext4 /dev/block/platform/soc/by-name/cache /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/cache /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

# persist (sensors / wifi MAC / calibration live here)
on init
    mount ext4 /dev/block/platform/soc/by-name/persist /persist nosuid nodev wait barrier=1
on init
    mount ext4 /dev/block/platform/soc/1da4000.ufshc/by-name/persist /persist nosuid nodev wait barrier=1

on init
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/wifi 0770 wifi wifi
    # KitKat wifi.c expects these but never creates them (CHARQUIRKS wifi):
    # supplicant ctrl-socket dir and dhcp lease dir.
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/log 0775 system log
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 system system
    # PRODUCT_COPY_FILES lands 644; the diag scripts must exec.
    chmod 0755 /system/bin/dump-boot-log.sh
    chmod 0755 /sbin/autowinch.sh

on init
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw

    # firmware_class.path: the kernel resolves firmware from the requester's
    # root; /vendor -> /system/vendor, where full_chiron.mk installs the
    # modem/adsp/tas2559/a540 blobs. A miss stalls ~60 s per file in ueventd.
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    # Modem first (PIL from /vendor/firmware), then the ADSP: with the service
    # locator enabled the ADSP's card/slimbus clients register through it and
    # the locator's domain data comes from the modem's servreg_loc service.
    start pdserve
    start modem_hold
    start adsp_boot
    # No /dev/alarm on the 4.4 kernel and the PMIC RTC is read-only: restore
    # wall time from the RTC + the offset system_server saved (rtc-restore,
    # patches/kitkat/frameworks-base-time-without-dev-alarm.patch).
    start rtc-restore
    # Zero-copy presentation: SurfaceFlinger's ION buffers are committed to the
    # MDSS pipe by fbpresentd (64-bit; the 32-bit compat path of
    # MSMFB_ATOMIC_COMMIT crashes this kernel). Must be up before the first
    # post; gralloc.<device> falls back to copy + FBIOPUT_VSCREENINFO otherwise.
    start fbpresentd
    # Touch: Mi MIX 2 uses the Synaptics DSX driver
    # (chiron_defconfig: CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_*). Same idc as
    # sagit; verify `getevent -p` lists an ABS_MT device on first boot.

on boot
    # Safety net: (re)start adbd now that init is up. No-op if running.
    start adbd
    # Bind the configfs gadget unconditionally: the sys.usb.config trigger is
    # unreliable (UsbDeviceManager owns the property once system_server runs).
    start usbudc
    start bootlog
    # bootloop guard: reboots to TWRP only if the boot never comes alive
    start autowinch

# LightsService writes these from system_server (uid system); the kernel
# registers every LED class attribute root:root 0644. Own stanza: a missing
# node aborts the rest of the action.
on boot
    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/white/trigger
    chown system system /sys/class/leds/white/brightness
    chown system system /sys/class/leds/white/blink
    chown system system /sys/class/leds/wled/brightness

# unattended-bringup guard: stands down when sys.boot_completed=1 or adbd is
# running; otherwise reboots to recovery after the fuse (default 900 s).
service autowinch /sbin/autowinch.sh
    user root
    oneshot
    disabled

# DIAG: no logcat sink (4.4 kernel has no CONFIG_LOGGER) — snapshots kmsg,
# loadavg and waiter channels to /data/misc for a TWRP-side pull.
service bootlog /system/bin/dump-boot-log.sh
    user root
    disabled

# internal storage only — no microSD on the Mi MIX 2, so no fuse_sdcard1
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class main

service fbpresentd /system/bin/fbpresentd
    class core
    user root
    group root graphics
    disabled

service rtc-restore /system/bin/rtc-restore
    class core
    user root
    oneshot
    disabled

# Modem boot + hold: opening /dev/subsys_modem runs the PIL load (mba.mbn,
# modem.mdt + modem.b00-*) and the fd must stay open for the life of the
# system (closing it shuts the modem down). Stock holds it from rild/tad;
# KitKat has neither. WLAN needs this: WLFW ("wlan/fw") is a modem QMI
# service. Missing firmware makes the open fail EAGAIN — the script retries.
service modem_hold /system/bin/sh /sbin/modem-hold.sh
    class core
    user root
    group root
    disabled

# SERVREG_LOC (QMI 0x40) provider: 32-bit stand-in for the 64-bit pd-mapper
# the stock ROM runs; serves the domain tables the kernel's service locator
# (and the modem) use to boot the WLAN PD.
service pdserve /system/bin/pdserve
    class core
    user root
    group root

# ADSP boot, sequenced after the modem (bounded 20 s wait, resolved by NAME).
# Without this write the sound card never probes ("No soundcards found").
service adsp_boot /system/bin/sh /sbin/adsp-boot.sh
    class core
    user root
    group root
    oneshot
    disabled

# Wifi: qca_cld3 is built into the kernel, so no insmod — but KitKat's
# wifi.c starts the supplicant by service name, and without these definitions
# `ctl.start wpa_supplicant` is a silent no-op. hammerhead pattern.
service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf \
    -puse_p2p_group_interface=1 -e/data/misc/wifi/entropy.bin \
    -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot
