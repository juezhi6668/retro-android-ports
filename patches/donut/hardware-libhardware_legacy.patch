@@ -288,6 +284,26 @@ int wifi_start_supplicant()
     /* Clear out any stale socket files that might be left over. */
     wpa_ctrl_cleanup();
 
+    /* Cooper (GT-S5830, ath6kl): mainline drivers leave wlan0 DOWN after
+     * probe (the legacy ar6000 auto-upped its interface, so stock Donut
+     * never needed this), and wpa_supplicant -w waits forever on a DOWN
+     * interface ("Waiting for interface..", scans impossible). Bring it up
+     * before starting the daemon. Non-fatal: the supplicant's own -w wait
+     * still covers a not-yet-probed driver. */
+    {
+        char iface[PROPERTY_VALUE_MAX];
+        property_get("wifi.interface", iface, "wlan0");
+        if (ifc_init() == 0) {
+            if (ifc_up(iface) < 0)
+                LOGE("Could not bring %s up: %s", iface, strerror(errno));
+            else
+                LOGD("Interface %s up", iface);
+            ifc_close();
+        } else {
+            LOGE("Could not ifc_init for %s up", iface);
+        }
+    }
