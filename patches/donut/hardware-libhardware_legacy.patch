@@ -39,6 +39,7 @@ static struct wpa_ctrl *monitor_conn;
 extern int do_dhcp();
 extern int ifc_init();
 extern void ifc_close();
+extern int ifc_up(const char *name);
 extern char *dhcp_lasterror();
 extern void get_dhcp_info();
 extern int init_module(void *, unsigned long, const char *);
@@ -199,20 +200,15 @@ int wifi_load_driver()
 
 int wifi_unload_driver()
 {
-    int count = 20; /* wait at most 10 seconds for completion */
-
-    if (rmmod(DRIVER_MODULE_NAME) == 0) {
-	while (count-- > 0) {
-	    if (!check_driver_loaded())
-		break;
-    	    usleep(500000);
-	}
-	if (count) {
-    	    return 0;
-	}
-	return -1;
-    } else
-        return -1;
+    /* Cooper (GT-S5830, ath6kl): never rmmod. Once the AR6003 is fully
+     * booted, delete_module wedges inside the driver's exit path and the
+     * module sits in "Unloading" forever; worse, the rmmod syscall itself
