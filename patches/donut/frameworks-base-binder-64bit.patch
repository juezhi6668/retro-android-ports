 struct binder_state;
 
+/* These mirror the kernel's 64-bit binder ABI (protocol 8): the 4.4 kernel
+ * on maple is built without the 32-bit protocol, so pointers and sizes in
+ * every structure the driver sees are 64 bits wide even in 32-bit userspace
+ * (binder_size_t/binder_uintptr_t from <linux/binder.h>). */
 struct binder_object
 {
     uint32_t type;
     uint32_t flags;
-    void *pointer;
-    void *cookie;
+    binder_uintptr_t pointer;
+    binder_uintptr_t cookie;
 };
 
 struct binder_txn
 {
-    void *target;
-    void *cookie;
+    binder_uintptr_t target;
+    binder_uintptr_t cookie;
     uint32_t code;
     uint32_t flags;
 
     uint32_t sender_pid;
     uint32_t sender_euid;
 
-    uint32_t data_size;
-    uint32_t offs_size;
-    void *data;
-    void *offs;
+    binder_size_t data_size;
+    binder_size_t offs_size;
+    binder_uintptr_t data;
+    binder_uintptr_t offs;
 };
 
 struct binder_io
 {
     char *data;            /* pointer to read/write from */
-    uint32_t *offs;        /* array of offsets */
+    binder_size_t *offs;   /* array of offsets */
     uint32_t data_avail;   /* bytes available in data buffer */
     uint32_t offs_avail;   /* entries available in offsets array */
 
     char *data0;           /* start of data buffer */
-    uint32_t *offs0;       /* start of offsets buffer */
+    binder_size_t *offs0;  /* start of offsets buffer */
     uint32_t flags;
     uint32_t unused;
 };
