+#define USB_FFS_ADB_EP0  "/dev/usb-ffs/adb/ep0"
+#define USB_FFS_ADB_OUT  "/dev/usb-ffs/adb/ep1"   /* host -> device */
+#define USB_FFS_ADB_IN   "/dev/usb-ffs/adb/ep2"   /* device -> host */
