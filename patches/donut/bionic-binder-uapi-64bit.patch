-#  define __get_tls() ( *((volatile void **) 0xffff0ff0) )
+#  if 0
+#    define __get_tls() ( *((volatile void **) 0xffff0ff0) )
+#  else
+static __inline__ void* __get_tls(void)
+{
+    void* tls;
+    /* TPIDRURO read: the kuser-helper page (0xffff0ff0) does not exist on
+     * an ARM64 kernel running AArch32 code (maple). TPIDRURO (p15 c13 c0 3)
+     * is the ARMv6+ register that the kernel's __ARM_NR_set_tls writes, so
+     * read it directly. The raw encoding is used because -march=armv5te (the
+     * Donut default) would otherwise reject the mrc mnemonic. */
+    __asm__ __volatile__ (".word 0xee1d0f70" : "=r"(tls));
+    return tls;
+}
+#  endif
 #else
 extern void*  __get_tls( void );
 #endif
