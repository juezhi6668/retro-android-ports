+// gles only lets glCopyTexImage2D take channels the read buffer has, so an opaque
+// (no alpha) pbuffer can never be copied into an rgba color buffer. desktop gl didn't
+// care, adreno does, and opaque windows like the wallpaper came out empty. contexts and
+// pbuffers both use the matching config with 8 bits of alpha (they have to agree for
+// eglMakeCurrent), the guest still sees the original config's attributes
+static EGLConfig withAlpha(EGLDisplay dpy, EGLConfig config)
+{
+    EGLint alpha = 0;
+    s_egl.eglGetConfigAttrib(dpy, config, EGL_ALPHA_SIZE, &alpha);
+    if (alpha > 0)
+        return config;
+
+    EGLint attribs[] = {
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 0, EGL_STENCIL_SIZE, 0, EGL_RENDERABLE_TYPE, 0,
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_NONE
+    };
+    s_egl.eglGetConfigAttrib(dpy, config, EGL_DEPTH_SIZE, &attribs[9]);
+    s_egl.eglGetConfigAttrib(dpy, config, EGL_STENCIL_SIZE, &attribs[11]);
+    s_egl.eglGetConfigAttrib(dpy, config, EGL_RENDERABLE_TYPE, &attribs[13]);
+
+    EGLConfig withAlpha;
+    EGLint n = 0;
+    if (s_egl.eglChooseConfig(dpy, attribs, &withAlpha, 1, &n) && n > 0)
+        return withAlpha;
+    return config;
+}
+
