+/* --- glr diag ------------------------------------------------------------ */
+// Ring of the last commands seen on this connection. Recorded per command, not
+// per decoder call, so the entry immediately before a framing loss is the one
+// whose declared length was wrong.
+#define GLR_RING 32
+typedef struct { int op; unsigned int plen; int len; unsigned int f[8]; } GlrEntry;
+static __thread GlrEntry g_glr_ring[GLR_RING];
+static __thread int g_glr_ringn = 0;
+
+static inline unsigned int glr_rd32(const unsigned char* p) {
+    unsigned int v = 0;
+    memcpy(&v, p, 4);
+    return v;
+}
+
+static void glr_record(int op, unsigned int plen, int len,
+                       const unsigned char* head, size_t avail) {
+    int idx = g_glr_ringn % GLR_RING;
+    g_glr_ring[idx].op = op;
+    g_glr_ring[idx].plen = plen;
+    g_glr_ring[idx].len = len;
+    for (int i = 0; i < 8; i++)
+        g_glr_ring[idx].f[i] = (avail >= (size_t)(12 + 4*i)) ? glr_rd32(head + 8 + 4*i) : 0;
+    g_glr_ringn++;
+}
+
+// The three opcode spaces are dense and disjoint (checked against the generated
+// tables): GLESv1 1024..1315, GLESv2 2048..2256, renderControl 10000..10025.
+static inline bool glr_known_op(int op) {
+    return (op >= 1024  && op <= 1315) ||
+           (op >= 2048  && op <= 2256) ||
+           (op >= 10000 && op <= 10025);
+}
+
+static void glr_dump_ring(int pid, const unsigned char* head, size_t avail) {
+    int m = avail < 64 ? (int)avail : 64;
+    fprintf(stderr, "[glr-rt] FRAMING LOST pid=%d avail=%u head:", pid, (unsigned)avail);
+    for (int i = 0; i < m; i++) fprintf(stderr, " %02x", head[i]);
+    fprintf(stderr, "\n");
+    // last 8 commands, with the raw header words (cb x y w h fmt type size)
+    for (int i = 8; i > 0; i--) {
+        int k = g_glr_ringn - i;
+        if (k < 0) continue;
+        const GlrEntry* e = &g_glr_ring[k % GLR_RING];
+        fprintf(stderr, "[glr-rt]   last[%d] op=%d plen=%u consumed=%d"
+                        " cb=%u x=%u y=%u w=%u h=%u fmt=0x%x type=0x%x size=%u\n",
+                -i, e->op, e->plen, e->len,
+                e->f[0], e->f[1], e->f[2], e->f[3], e->f[4], e->f[5], e->f[6], e->f[7]);
+    }
+    fflush(stderr);
+}
+
+// Find the next real message boundary. Candidate offsets are rare (the opcode
+// has to be one of ~530 values), so we can walk forward from a candidate and
+// require a run of well-formed messages rather than trusting a single match.
+// Note: since the guest fork-safety fix in HostConnection this path no longer
+// triggers in practice - it is a safety net.
+#define GLR_RESYNC_RUN 2
+static size_t glr_resync(const unsigned char* buf, size_t avail) {
+    for (size_t off = 4; off + 8 <= avail; off += 4) {
+        unsigned int op = glr_rd32(buf + off);
+        if (!glr_known_op((int)op)) continue;
+        unsigned int plen = glr_rd32(buf + off + 4);
+        if (plen < 8 || plen > GLR_MAX_MSG) continue;
+
+        size_t p = off;
+        int run = 0;
+        bool ok = true;
+        while (run < GLR_RESYNC_RUN && p + 8 <= avail) {
+            unsigned int o = glr_rd32(buf + p);
+            unsigned int l = glr_rd32(buf + p + 4);
+            if (!glr_known_op((int)o) || l < 8 || l > GLR_MAX_MSG) { ok = false; break; }
+            if (p + l > avail) break;      // ran out of buffered data mid-run
+            p += l;
+            run++;
+        }
+        // accept a long run, or whatever we could verify if the buffer ends
+        if (ok && run >= ((avail - off) > (size_t)GLR_MAX_MSG ? GLR_RESYNC_RUN : 2))
+            return off;
+    }
+    return 0;
+}
+
+/* --- raw stream history -------------------------------------------------- */
+// A rolling copy of everything this connection sent, so the first framing loss
+// can be written out with its cause intact. 12 MiB covers the largest message
+// (8.3 MB) plus the ones before it.
+#define GLR_HIST (12u<<20)
+static __thread unsigned char* g_hist;
+static __thread size_t g_histPos;
+static __thread size_t g_histTotal;
+static __thread bool g_histSaved;
+
+static void glr_hist_append(const unsigned char* p, size_t n) {
+    if (!g_hist) {
+        g_hist = (unsigned char*)malloc(GLR_HIST);
+        if (!g_hist) return;
+    }
+    while (n) {
+        size_t chunk = GLR_HIST - g_histPos;
+        if (chunk > n) chunk = n;
+        memcpy(g_hist + g_histPos, p, chunk);
+        g_histPos = (g_histPos + chunk) % GLR_HIST;
+        g_histTotal += chunk;
+        p += chunk;
+        n -= chunk;
+    }
+}
+
+static void glr_hist_save(int pid) {
+    if (g_histSaved || !g_hist || g_histTotal == 0) return;
+    g_histSaved = true;
+    char path[64];
+    snprintf(path, sizeof(path), "/dev/glr-stream-%d.bin", pid);
+    FILE* f = fopen(path, "wb");
+    if (!f) {
+        fprintf(stderr, "[glr-rt] could not open %s for stream history\n", path);
+        fflush(stderr);
+        return;
+    }
+    size_t start = (g_histTotal >= GLR_HIST) ? g_histPos : 0;
+    size_t len   = (g_histTotal >= GLR_HIST) ? GLR_HIST : g_histPos;
+    fwrite(g_hist + start, 1, GLR_HIST - start, f);
+    if (start) fwrite(g_hist, 1, start, f);
+    fclose(f);
+    fprintf(stderr, "[glr-rt] wrote %u bytes of stream history to %s\n",
+            (unsigned)len, path);
+    fflush(stderr);
+}
