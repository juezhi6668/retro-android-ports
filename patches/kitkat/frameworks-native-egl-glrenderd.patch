-        return -1;
-
-    /* We are in the emulator, get GPU status value */
-    property_get("ro.kernel.qemu.gles",prop,"0");
-    return atoi(prop);
+    pthread_once(&s_renderdOnce, probeRenderd);
+    return s_renderdStatus;
 }
 
