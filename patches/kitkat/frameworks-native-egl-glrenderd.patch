-/* This function is called to check whether we run inside the emulator,
- * and if this is the case whether GLES GPU emulation is supported.
- *
- * Returned values are:
- *  -1   -> not running inside the emulator
- *   0   -> running inside the emulator, but GPU emulation not supported
- *   1   -> running inside the emulator, GPU emulation is supported
- *          through the "emulation" config.
- */
+// glrenderd (adreno in a lineage chroot) or nothing. the chroot only ships when it was staged,
+// and surfaceflinger can beat glrenderd to its socket, so wait a little before giving up.
+// gralloc.maple's RenderdStream::available() makes the same call so the two never disagree
+static const char kRenderdSocket[] = "glrenderd";
+static const char kRenderdBinary[] = "/system/glr/root/glrenderd";
+static const int kRenderdWaitTries = 50;
+static const useconds_t kRenderdWaitStepUs = 100000;
+
+static int s_renderdStatus;
+static pthread_once_t s_renderdOnce = PTHREAD_ONCE_INIT;
+
+static void probeRenderd()
+{
+    if (access(kRenderdBinary, F_OK))
+        return;
+    for (int i = 0; i < kRenderdWaitTries; i++) {
+        int fd = socket_local_client(kRenderdSocket, ANDROID_SOCKET_NAMESPACE_ABSTRACT, SOCK_STREAM);
+        if (fd >= 0) {
+            close(fd);
+            s_renderdStatus = 1;
+            return;
+        }
+        usleep(kRenderdWaitStepUs);
+    }
+}
+
+/* the emulator's answer, 1 picks the emulation libs and 0 the software renderer */
 static int
 checkGlesEmulationStatus(void)
 {
-    /* We're going to check for the following kernel parameters:
