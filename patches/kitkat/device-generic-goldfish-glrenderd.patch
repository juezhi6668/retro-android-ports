+// How long to wait for a reply. A legitimate reply is one renderer round-trip:
+// milliseconds, or a full-frame readback (~8 MB) at worst. Anything past this is
+// a wedged renderer, not a slow one. Overridable for experiments without a
+// rebuild:  setprop persist.glr.replytimeout <seconds>
+#define GLR_REPLY_TIMEOUT_DEFAULT 20
+
+static __thread bool t_streamDead = false;
+
+bool glrGuestStreamDead() { return t_streamDead; }
+
+void glrGuestStreamRevive()
+{
+    if (t_streamDead) {
+        t_streamDead = false;
+        // only on the transition: HostConnection::get() calls this on every GL call
+        ERR("glr-guest: reconnecting to the renderer\n");
+    }
+}
+
+static void glrMarkDead(const char *why)
+{
+    if (!t_streamDead) {
+        t_streamDead = true;
+        ERR("glr-guest: giving up on the renderer (%s)\n", why);
+    }
+}
+
+void glrGuestSetReplyTimeout(int sock)
+{
+    if (sock < 0) return;
+
+    int secs = GLR_REPLY_TIMEOUT_DEFAULT;
+    char v[PROP_VALUE_MAX];
+    if (__system_property_get("persist.glr.replytimeout", v) > 0) {
+        int n = atoi(v);
+        if (n > 0 && n < 3600) secs = n;
+    }
+
+    struct timeval tv;
+    tv.tv_sec = secs;
+    tv.tv_usec = 0;
+    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    // MAPLE: bound the write side too. If the renderer stops draining its
+    // socket, send() would otherwise park the caller forever.
+    setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+}
+
+// MAPLE: the kernel default socket buffer is 208 KB (net.core.{r,w}mem_default)
+// while one UI frame's GL command stream is easily several hundred KB. With a
+// socket that small the guest blocks in send() in the middle of a frame until
+// the renderer consumed it, serializing guest work with host work (measured:
+// ~30 fps cap, every frame submitted on the heels of the previous readback).
+// Let a frame or two be in flight: raise both directions. The system caps are
+// raised to 16 MiB by glrenderd before it listens.
+#define GLR_SOCK_BUF (8u << 20)
+
+void glrSetSocketBuffers(int sock)
+{
+    if (sock < 0) return;
+    int sz = GLR_SOCK_BUF;
+    setsockopt(sock, SOL_SOCKET, SO_SNDBUF, &sz, sizeof(sz));
+    setsockopt(sock, SOL_SOCKET, SO_RCVBUF, &sz, sizeof(sz));
+}
