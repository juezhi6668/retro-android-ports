diff --git a/opengl/system/OpenglSystemCommon/RenderdStream.cpp b/opengl/system/OpenglSystemCommon/RenderdStream.cpp
new file mode 100644
index 0000000..fcba750
--- /dev/null
+++ b/opengl/system/OpenglSystemCommon/RenderdStream.cpp
@@ -0,0 +1,42 @@
+// ported from pdx203-jellybean by @chardidathing, https://github.com/chardidathing/pdx203-jellybean
+#include "RenderdStream.h"
+#include <cutils/sockets.h>
+#include <pthread.h>
+#include <unistd.h>
+
+static const char kSocketName[] = "glrenderd";
+// shipped only when the chroot was staged, without it there's nothing to wait for
+static const char kRenderdBinary[] = "/system/glr/root/glrenderd";
+// glrenderd starts in post-fs-data, surfaceflinger can still beat it to the socket
+static const int kWaitTries = 50;
+static const useconds_t kWaitStepUs = 100000;
+
+int RenderdStream::connect(unsigned short port)
+{
+    m_sock = socket_local_client(kSocketName, ANDROID_SOCKET_NAMESPACE_ABSTRACT, SOCK_STREAM);
+    return valid() ? 0 : -1;
+}
+
+static bool s_available;
+static pthread_once_t s_availableOnce = PTHREAD_ONCE_INIT;
+
+static void probe()
+{
+    if (access(kRenderdBinary, F_OK))
+        return;
+    for (int i = 0; i < kWaitTries; i++) {
+        int fd = socket_local_client(kSocketName, ANDROID_SOCKET_NAMESPACE_ABSTRACT, SOCK_STREAM);
+        if (fd >= 0) {
+            close(fd);
+            s_available = true;
+            return;
+        }
+        usleep(kWaitStepUs);
+    }
+}
+
+bool RenderdStream::available()
+{
+    pthread_once(&s_availableOnce, probe);
+    return s_available;
+}
diff --git a/opengl/system/OpenglSystemCommon/RenderdStream.h b/opengl/system/OpenglSystemCommon/RenderdStream.h
new file mode 100644
index 0000000..15d272d
--- /dev/null
+++ b/opengl/system/OpenglSystemCommon/RenderdStream.h
@@ -0,0 +1,22 @@
+// ported from pdx203-jellybean by @chardidathing, https://github.com/chardidathing/pdx203-jellybean
+#ifndef __RENDERD_STREAM_H
+#define __RENDERD_STREAM_H
+
+#include "SocketStream.h"
+
+// talks to glrenderd, the adreno renderer running in the lineage chroot,
+// over an abstract unix socket instead of the emulator's qemu pipe
+class RenderdStream : public SocketStream {
+public:
+    explicit RenderdStream(size_t bufsize = 10000) : SocketStream(bufsize) {}
+    virtual int listen(unsigned short port) { return -1; }
+    virtual SocketStream *accept() { return NULL; }
+    virtual int connect(unsigned short port);
+    int connect() { return connect(0); }
+
+    // whether this process should use glrenderd at all, decided once. the egl loader in
+    // frameworks/native makes the same call so gralloc and egl never disagree
+    static bool available();
+};
+
+#endif
