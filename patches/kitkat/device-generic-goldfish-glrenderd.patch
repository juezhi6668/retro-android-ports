+// image specification always hits the GL_TEXTURE_2D binding, but while texture_external_oes is
+// enabled the host has the external texture bound there, so swap the real 2d one in first
+bool GLEncoder::bindTexture2DForImage(GLenum target)
+{
+    if (target != GL_TEXTURE_2D ||
+            m_state->getPriorityEnabledTarget(GL_TEXTURE_2D) == GL_TEXTURE_2D)
+        return false;
+    m_glBindTexture_enc(this, GL_TEXTURE_2D, m_state->getBoundTexture(GL_TEXTURE_2D));
+    return true;
+}
+
+void GLEncoder::s_glTexImage2D(void* self, GLenum target, GLint level, GLint internalformat,
+        GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, const GLvoid* pixels)
+{
+    GLEncoder* ctx = (GLEncoder*)self;
+    bool swapped = ctx->bindTexture2DForImage(target);
+    ctx->m_glTexImage2D_enc(ctx, target, level, internalformat, width, height, border,
+            format, type, pixels);
+    if (swapped)
+        ctx->restore2DTextureTarget();
+}
