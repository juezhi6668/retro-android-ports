+// POPLAR: how long a frozen dispatch may last before we lift it ourselves.
+// WindowManagerService freezes dispatch around window transitions; a real
+// transition is a few hundred milliseconds. If the transition never completes
+// (e.g. the app that was transitioning died), the frozen branch below returns
+// without setting nextWakeupTime, so the dispatcher sleeps forever and the
+// device keeps drawing a UI that accepts no touch at all.
+#define kMaxDispatchFreezeNanos (10 * 1000000000LL)
+
 void InputDispatcher::dispatchOnceInnerLocked(nsecs_t* nextWakeupTime) {
     nsecs_t currentTime = now();
 
@@ -257,10 +266,40 @@ void InputDispatcher::dispatchOnceInnerLocked(nsecs_t* nextWakeupTime) {
 
     // If dispatching is frozen, do not process timeouts or try to deliver any new events.
     if (mDispatchFrozen) {
+        if (mDispatchFrozenTime
+                && currentTime - mDispatchFrozenTime > kMaxDispatchFreezeNanos) {
+            // POPLAR: whoever froze us is not coming back. Lift it, or input stays
+            // dead for the rest of the boot (the UI keeps animating, touches queue
+            // up in mInboundQueue and go nowhere).
+            nsecs_t frozenForMs = (currentTime - mDispatchFrozenTime) / 1000000;
+            ALOGE("Dispatch has been frozen for %lld ms - forcing it back on, "
+                  "input would otherwise be dead for good",
+                  (long long)frozenForMs);
+            FILE* fp = fopen("/data/system/dispatch-thaw.log", "a");
+            if (fp) {
+                fprintf(fp, "frozen for %lld ms at uptime-ish %lld ms, forcing thaw\n",
+                        (long long)frozenForMs, (long long)(systemTime(SYSTEM_TIME_BOOTTIME) / 1000000));
+                fclose(fp);
+            }
+            mDispatchFrozen = false;
+            mDispatchFrozenTime = 0;
+            resetANRTimeoutsLocked();
+            mLooper->wake();
+            // fall through and dispatch normally
+        } else {
 #if DEBUG_FOCUS
-        ALOGD("Dispatch frozen.  Waiting some more.");
+            ALOGD("Dispatch frozen.  Waiting some more.");
 #endif
-        return;
+            // Wake up when the deadline passes, otherwise this branch parks the
+            // dispatcher on an infinite poll timeout and it is never re-checked.
+            if (mDispatchFrozenTime) {
+                nsecs_t deadline = mDispatchFrozenTime + kMaxDispatchFreezeNanos;
+                if (deadline < *nextWakeupTime) {
+                    *nextWakeupTime = deadline;
+                }
+            }
+            return;
+        }
     }
 
